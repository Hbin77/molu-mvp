# Port the molu-mvp container publishes on the host (loopback only).
# If the default 3000 is taken, pick another (3100 / 3300 / 3700 etc.).
HOST_PORT=3300

# Backend URL used by Next.js server-side rewrites.
# Defaults to http://molu-api:8000 (container name on the shared molu-net network).
# Override only if you point at something else (e.g. http://host.docker.internal:8200
# during local debugging without the shared network).
# API_INTERNAL_URL=http://molu-api:8000
