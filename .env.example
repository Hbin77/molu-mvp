# Copy to .env on the server.
# Port (used at runtime). If the default 3000 is taken, pick another (3100 / 3300 / 3700 etc.).
HOST_PORT=3300

# Backend API base URL (used at BUILD time — bundled into the static client).
# Must be the public URL the browser can reach.
NEXT_PUBLIC_API_BASE=https://api.molu.likelionscnu.site
